/**
 * @file appconstants/appconstants.cpp
 * Contains the AppConstants namespace implementation.
*/

#include <string_view>

#include "appconstants/appconstants.hpp"

std::string_view AppConstants::SystemConfigFile()
{
    return "@CMAKE_INSTALL_FULL_DATAROOTDIR@/@CMAKE_PROJECT_NAME@/@CONF_FILE_NAME@";
}

std::string_view AppConstants::UserConfigFile()
{
    return "@CMAKE_INSTALL_FULL_SYSCONFDIR@/@CMAKE_PROJECT_NAME@/@CONF_FILE_NAME@";
}

std::string_view AppConstants::DataRootPrefix()
{
    return "@CMAKE_INSTALL_FULL_DATAROOTDIR@";
}

std::string_view AppConstants::SysConfPrefix()
{
    return "@CMAKE_INSTALL_FULL_SYSCONFDIR@";
}

std::string_view AppConstants::StandardDataRootPrefix()
{
    return "/usr/share";
}

std::string_view AppConstants::ConfigFileName()
{
    return "@CONF_FILE_NAME@";
}

std::string_view AppConstants::ProductName()
{
    return "@CMAKE_PROJECT_NAME@";
}

std::string_view AppConstants::ProductVersion()
{
    return "@CMAKE_PROJECT_VERSION@";
}

std::string_view AppConstants::ProductRelease()
{
    return "@PRODUCT_RELEASE_EXTENDED@";
}
