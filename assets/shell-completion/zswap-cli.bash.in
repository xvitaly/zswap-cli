_zswap_cli()
{
    local cur prev words cword comp_args
    _comp_initialize -- "$@" || return

    case "$prev" in
        --accept_threshold_percent | --max_pool_percent)
            _comp_compgen -- -W "{1..100}"
            return
            ;;
        --compressor)
            _comp_compgen -- -W "842 deflate lzo lz4 lz4hc zstd"
            return
            ;;
        --config)
            _comp_compgen_filedir "@(conf|ini)"
            return
            ;;
        --enabled | --same_filled_pages_enabled | --non_same_filled_pages_enabled | --exclusive_loads | --shrinker_enabled)
            _comp_compgen -- -W "Y N"
            return
            ;;
        --env | --system | --version | --help | --verbose)
            return
            ;;
        --stats)
            _comp_compgen -- -W "{0..3}"
            return
            ;;
        --zpool)
            _comp_compgen -- -W "z3fold zbud zsmalloc"
            return
            ;;
    esac

    if [[ "$cur" == -* ]]; then
        _comp_compgen_help
        [[ "${COMPREPLY-}" == *= ]] && compopt -o nospace
    fi
} &&
    complete -F _zswap_cli @APP_NAME@

# ex: filetype=sh
